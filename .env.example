# ===============================================
# ApplyLog — Production Configuration Example
# ===============================================

# Server Ports & Node Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://applylog:applylog_secret@localhost:5432/applylog_db?schema=public

# Redis URL (Used for background workers & rate limiting)
REDIS_URL=redis://localhost:6379

# Authentication & Security Secrets
JWT_SECRET=super_secret_jwt_key_applylog_2026_change_in_prod
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_applylog_2026_change_in_prod
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# AES-256 Secret Key for Credentials & OAuth Token Encryption (32-byte hex)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15
